# Copy to .env.local for local dev, and add the same names in Vercel
# (Project → Settings → Environment Variables) for Production and Preview.

# EmailJS: emails a copy of each contact page enquiry (src/lib/email-copy.ts),
# alongside GHL, until a GHL workflow sends the notification. See SETUP.md.
# Get these values from https://dashboard.emailjs.com/admin
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Google Analytics 4 Measurement ID (G-…): GA → Admin → Data streams → Web.
# Set it in Vercel for Production only, so previews don't send data. Leave it
# blank locally unless you're testing the tag. See SETUP.md.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel (dataset) ID: Events Manager → Data sources. Turns on the Pixel and,
# with the token below, the Conversions API. Set both in Vercel for Production
# only, so previews don't send data. See SETUP.md.
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API access token: Events Manager → the dataset → Settings →
# Conversions API → Generate access token. Server-only; never NEXT_PUBLIC_.
META_CAPI_ACCESS_TOKEN=
# Optional: the code from Events Manager → Test events, so server events show
# up there while you check the setup. Remove it afterwards.
META_TEST_EVENT_CODE=

# GoHighLevel: used by /api/lead (src/app/api/lead/route.ts) and scripts/.
# Server-only. Never add a NEXT_PUBLIC_ prefix to these.
# Private Integration token (Settings → Private Integrations); scopes in SETUP.md.
GHL_PRIVATE_TOKEN=
# Sub-account (location) ID: Settings → Business Profile.
GHL_LOCATION_ID=

# Optional, local only: lets scripts/test-lead.mjs reach a Vercel preview that
# has Deployment Protection on (Vercel → Settings → Deployment Protection →
# Protection Bypass for Automation). Not needed in Vercel itself.
VERCEL_AUTOMATION_BYPASS_SECRET=
