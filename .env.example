# Copy to .env.local for local dev, and add the same names in Vercel
# (Project → Settings → Environment Variables) for Production and Preview.

# EmailJS: used by src/components/sections/ContactForm.tsx
# Get these values from https://dashboard.emailjs.com/admin
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# GoHighLevel: used by /api/lead (src/app/api/lead/route.ts) and scripts/.
# Server-only. Never add a NEXT_PUBLIC_ prefix to these.
# Private Integration token (Settings → Private Integrations); scopes in SETUP.md.
GHL_PRIVATE_TOKEN=
# Sub-account (location) ID: Settings → Business Profile.
GHL_LOCATION_ID=

# Optional, local only: lets scripts/test-lead.mjs reach a Vercel preview that
# has Deployment Protection on (Vercel → Settings → Deployment Protection →
# Protection Bypass for Automation). Not needed in Vercel itself.
VERCEL_AUTOMATION_BYPASS_SECRET=
